rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper function for admin verification via Firestore database 'noma'
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        firestore.get(/databases/noma/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isUnder10MB() {
      return request.resource.size < 10 * 1024 * 1024;
    }

    // =======================================================
    // STORAGE ACCESS RULES
    // =======================================================
    // - Public Read: Product & banner images can be viewed by all storefront visitors
    // - Admin Write: Only authenticated admins can upload images under 10MB
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isImage() && isUnder10MB();
    }
  }
}
