rules_version = '2';

// Fallback Firebase Storage rules (primary media storage runs on Cloudflare R2 via /api/media/upload).
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        firestore.exists(/databases/noma/documents/users/$(request.auth.uid)) &&
        firestore.get(/databases/noma/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isSafeImage() {
      return request.resource.contentType.matches('image/(jpeg|jpg|png|webp|avif)');
    }

    function isUnder10MB() {
      return request.resource.size <= 10 * 1024 * 1024;
    }

    // Public read for product & banner assets; admin-only image uploads up to 10 MB
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isSafeImage() && isUnder10MB();
    }
  }
}
